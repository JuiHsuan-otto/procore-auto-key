{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.carkey-casepilot.local/publication-action/v1/promotion-plan.schema.json",
  "title": "CarKey Promotion Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "plan_version", "state", "plan_hash", "action_id", "action_hash", "action", "action_revision", "public_record_id", "candidate_id", "candidate_revision", "candidate_hash", "package_hash", "expected_base_sha", "current_base_sha", "expected_current_state", "proposed_branch", "operations", "lifecycle", "public_page", "asset_copies", "registry_sync", "required_checks", "risk_flags", "human_review_checklist", "publication_authority", "rollback", "receipt_template", "synthetic", "network_used"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "plan_version": { "const": "promotion-plan/v1" },
    "state": { "const": "validated_branch_plan" },
    "plan_hash": { "$ref": "#/$defs/sha256" },
    "action_id": { "$ref": "#/$defs/actionId" },
    "action_hash": { "$ref": "#/$defs/sha256" },
    "action": { "enum": ["publish", "correct", "withdraw"] },
    "action_revision": { "type": "integer", "minimum": 1 },
    "public_record_id": { "type": "string", "pattern": "^pcr_[a-f0-9]{16}$" },
    "candidate_id": { "type": "string", "pattern": "^cpc_[a-f0-9]{16}$" },
    "candidate_revision": { "type": "integer", "minimum": 1 },
    "candidate_hash": { "$ref": "#/$defs/sha256" },
    "package_hash": { "$ref": "#/$defs/sha256" },
    "expected_base_sha": { "$ref": "#/$defs/gitSha" },
    "current_base_sha": { "$ref": "#/$defs/gitSha" },
    "expected_current_state": { "enum": ["unpublished", "published", "withdrawn"] },
    "proposed_branch": { "type": "string", "pattern": "^content/casepilot-(publish|correct|withdraw)-[a-f0-9]{16}$" },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_to_add", "files_to_modify", "files_to_remove", "internal_link_targets", "sitemap_operation", "redirect_operation", "canonical_operation", "asset_operation"],
      "properties": {
        "files_to_add": { "$ref": "#/$defs/pathList" },
        "files_to_modify": { "$ref": "#/$defs/pathList" },
        "files_to_remove": { "$ref": "#/$defs/pathList" },
        "internal_link_targets": { "$ref": "#/$defs/pathList" },
        "sitemap_operation": { "enum": ["ensure_present", "remove"] },
        "redirect_operation": { "enum": ["none", "replacement"] },
        "canonical_operation": { "enum": ["create", "preserve"] },
        "asset_operation": { "enum": ["copy", "replace_approved", "archive_then_remove_public"] }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code", "requested_resolution", "prior_action_id", "prior_receipt_hash", "expected_current_public_content_hash", "prior_canonical_url", "replacement_url", "preserve_publication_history"],
      "properties": {
        "reason_code": { "type": "string" },
        "requested_resolution": { "type": "string" },
        "prior_action_id": { "oneOf": [{ "$ref": "#/$defs/actionId" }, { "type": "null" }] },
        "prior_receipt_hash": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "expected_current_public_content_hash": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "prior_canonical_url": { "oneOf": [{ "$ref": "#/$defs/canonicalUrl" }, { "type": "null" }] },
        "replacement_url": { "oneOf": [{ "$ref": "#/$defs/canonicalUrl" }, { "type": "null" }] },
        "preserve_publication_history": { "const": true }
      }
    },
    "public_page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "canonical_url", "title", "description", "publication_date", "content_type"],
      "properties": {
        "path": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.html$" },
        "canonical_url": { "$ref": "#/$defs/canonicalUrl" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "publication_date": { "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }] },
        "content_type": { "const": "public_case" }
      }
    },
    "asset_copies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "draft_path", "destination", "sha256", "width", "height", "alt"],
        "properties": {
          "source": { "type": "string", "pattern": "^assets/" },
          "draft_path": { "type": "string", "pattern": "^assets/" },
          "destination": { "type": "string", "pattern": "^img/casepilot/" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "alt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "registry_sync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "mode", "tool", "arguments", "mutated_paths"],
      "properties": {
        "required": { "const": true },
        "mode": { "enum": ["upsert", "remove"] },
        "tool": { "const": "publish_tool.py" },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "mutated_paths": { "$ref": "#/$defs/pathList" }
      }
    },
    "required_checks": { "$ref": "#/$defs/nonEmptyStringList" },
    "risk_flags": { "$ref": "#/$defs/nonEmptyStringList" },
    "human_review_checklist": { "$ref": "#/$defs/nonEmptyStringList" },
    "publication_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apply_automated", "pr_automated", "merge_automated", "deploy_automated", "owner_review_required"],
      "properties": { "apply_automated": { "const": false }, "pr_automated": { "const": false }, "merge_automated": { "const": false }, "deploy_automated": { "const": false }, "owner_review_required": { "const": true } }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_merge", "after_merge", "production"],
      "properties": { "before_merge": { "type": "string" }, "after_merge": { "type": "string" }, "production": { "type": "string" } }
    },
    "receipt_template": { "$ref": "publication-action-receipt.schema.json" },
    "synthetic": { "const": true },
    "network_used": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "actionId": { "type": "string", "pattern": "^pca_[a-f0-9]{16}$" },
    "canonicalUrl": { "type": "string", "format": "uri", "pattern": "^https://www\\.carkey\\.com\\.tw/" },
    "pathList": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nonEmptyStringList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
